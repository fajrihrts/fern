.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Composer
/vendor/
composer.lock

# Node
node_modules/
npm-debug.log
yarn-error.log

# Temporary files
*.tmp
*.bak
*.old

# Database dumps
*.sql.gz
*.sql.zip

# Test files (keep in repo but ignore results)
test-*.php
!test-db-connection.php

# Documentation (optional - keep locally but don't commit)
