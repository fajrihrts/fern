# Environment & Config
config.php
.env
.env.local

# Logs
logs/*.log
!logs/.htaccess

# Cache
cache/*.cache
!cache/.htaccess
cache/rate_limits/*
!cache/rate_limits/.gitignore

# Uploads
uploads/*
